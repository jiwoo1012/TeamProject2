rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isValidMemberCreate(userId) {
      return request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'user'
        && request.resource.data.status == 'active'
        && request.resource.data.points == 0;
    }

    function keepsMemberAuthority() {
      return request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.points == resource.data.points
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function isValidAddress() {
      return request.resource.data.keys().hasAll([
          'label', 'recipient', 'phone', 'address', 'detailAddress', 'isDefault'
        ])
        && request.resource.data.label is string
        && request.resource.data.recipient is string
        && request.resource.data.phone is string
        && request.resource.data.address is string
        && request.resource.data.detailAddress is string
        && request.resource.data.isDefault is bool;
    }

    function isValidCartItem(productId) {
      return request.resource.data.keys().hasOnly(['productId', 'quantity'])
        && request.resource.data.productId == productId
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0;
    }

    match /users/{userId} {
      allow create: if isOwner(userId) && isValidMemberCreate(userId);
      allow read: if isOwner(userId) || isAdmin();
      allow update: if (isOwner(userId) && keepsMemberAuthority()) || isAdmin();
      allow delete: if isAdmin();

      match /wishlist/{wishlistId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /addresses/{addressId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidAddress();
        allow delete: if isOwner(userId);
      }

      match /cart/{productId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidCartItem(productId);
        allow delete: if isOwner(userId);
      }
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if (signedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
