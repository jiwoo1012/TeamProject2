rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================
    // 공통 함수
    // ========================================

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn()
        && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == 'admin';
    }


    // ========================================
    // 회원 생성 / 수정 검증
    // ========================================

    function isValidMemberCreate(userId) {
      return request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'user'
        && request.resource.data.status == 'active'
        && request.resource.data.points == 1000;
    }

    function keepsMemberAuthority() {
      return request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.points == resource.data.points
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function canUsePoints() {
      return request.resource.data.points is int
        && request.resource.data.points >= 0
        && request.resource.data.points <= resource.data.points
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'points',
            'updatedAt'
          ]);
    }

    function canEarnEventPoints(userId) {
      let participation = getAfter(
        /databases/$(database)/documents/eventParticipations/$(request.resource.data.lastEventRewardId)
      ).data;
      return isOwner(userId)
        && request.resource.data.points is int
        && participation.userId == userId
        && request.resource.data.lastEventRewardId
          == participation.eventId + '_' + userId
        && request.resource.data.points
          == resource.data.points + participation.rewardPoints
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'points',
          'lastEventRewardId',
          'updatedAt'
        ]);
    }


    // ========================================
    // 배송지 검증
    // ========================================

    function isValidAddress() {
      return request.resource.data.keys().hasAll([
        'label',
        'recipient',
        'phone',
        'address',
        'detailAddress',
        'isDefault'
      ])
        && request.resource.data.label is string
        && request.resource.data.recipient is string
        && request.resource.data.phone is string
        && request.resource.data.address is string
        && request.resource.data.detailAddress is string
        && request.resource.data.isDefault is bool;
    }


    // ========================================
    // 장바구니 검증
    // ========================================

    function isValidCartItem(productId) {
      return request.resource.data.keys().hasOnly([
        'productId',
        'quantity'
      ])
        && request.resource.data.productId == productId
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0;
    }


    // ========================================
    // USERS
    // ========================================

    match /users/{userId} {

      allow create:
        if isOwner(userId)
        && isValidMemberCreate(userId);

      allow read:
        if isOwner(userId)
        || isAdmin();

      allow update:
        if (
          isOwner(userId)
          && (
            keepsMemberAuthority()
            || canUsePoints()
            || canEarnEventPoints(userId)
          )
        )
        || isAdmin();

      allow delete:
        if isAdmin();


      // ========================================
      // WISHLIST
      // ========================================

      match /wishlist/{wishlistId} {

        // 본인 + 관리자 조회 가능
        allow read:
          if isOwner(userId)
          || isAdmin();

        // 수정은 회원 본인만 가능
        allow create, update, delete:
          if isOwner(userId);
      }


      // ========================================
      // ADDRESSES
      // ========================================

      match /addresses/{addressId} {

        allow read:
          if isOwner(userId);

        allow create, update:
          if isOwner(userId)
          && isValidAddress();

        allow delete:
          if isOwner(userId);
      }


      // ========================================
      // CART
      // ========================================

      match /cart/{productId} {

        allow read:
          if isOwner(userId);

        allow create, update:
          if isOwner(userId)
          && isValidCartItem(productId);

        allow delete:
          if isOwner(userId);
      }

      match /pointHistory/{historyId} {
        allow read:
          if isOwner(userId);

        allow create:
          if isAdmin()
          || (isOwner(userId)
          && request.resource.data.type == 'earn'
          && request.resource.data.amount is int
          && request.resource.data.amount > 0
          && historyId == 'event_' + request.resource.data.eventId + '_' + userId
          && get(
            /databases/$(database)/documents/eventParticipations/$(request.resource.data.eventId + '_' + userId)
          ).data.rewardPoints == request.resource.data.amount);

        allow update, delete:
          if false;
      }
    }


    // ========================================
    // NOTICES
    // ========================================

    match /notices/{noticeId} {

      // 일반 사용자는 게시된 공지만 조회
      // 관리자는 모든 공지 조회 가능
      allow read:
        if resource.data.status == 'published'
        || isAdmin();

      allow create, update, delete:
        if isAdmin();
    }


    // ========================================
    // REVIEWS
    // ========================================

    function hasPurchasedProduct(
      orderId,
      productId
    ) {
      return get(
        /databases/$(database)/documents/orders/$(orderId)
      ).data.userId == request.auth.uid

        && productId in get(
          /databases/$(database)/documents/orders/$(orderId)
        ).data.productIds;
    }


    function isValidReviewCreate() {
      return request.resource.data.keys().hasAll([
        'orderId',
        'productId',
        'authorId',
        'nickname',
        'rating',
        'content',
        'status',
        'reportCount',
        'createdAt'
      ])

        && request.resource.data.orderId is string
        && request.resource.data.productId is string

        && request.resource.data.authorId
          == request.auth.uid

        && hasPurchasedProduct(
          request.resource.data.orderId,
          request.resource.data.productId
        )

        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 30

        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5

        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 500

        && request.resource.data.status == 'visible'
        && request.resource.data.reportCount == 0

        && request.resource.data.createdAt is timestamp;
    }


    function isValidReviewOwnerUpdate() {
      return request.auth.uid
          == resource.data.authorId

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'nickname',
            'rating',
            'content',
            'updatedAt'
          ])

        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 30

        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5

        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 500;
    }


    match /reviews/{reviewId} {

      allow read:
        if resource.data.status == 'visible'
        || isAdmin()
        || (
          signedIn()
          && request.auth.uid
            == resource.data.authorId
        );

      allow create:
        if signedIn()
        && isValidReviewCreate();

      allow update:
        if isAdmin()
        || (
          signedIn()
          && isValidReviewOwnerUpdate()
        );

      allow delete:
        if isAdmin()
        || (
          signedIn()
          && request.auth.uid
            == resource.data.authorId
        );
    }


    // ========================================
    // PRODUCTS
    // ========================================

    match /products/{productId} {

      allow read:
        if true;

      allow create, update, delete:
        if isAdmin();
    }


    // ========================================
    // EVENTS
    // ========================================

    match /events/{eventId} {

      allow read:
        if true;

      allow create, update, delete:
        if isAdmin();
    }


    // ========================================
    // PRODUCT PAIRINGS
    // ========================================

    match /pairings/{pairingId} {

      allow read:
        if true;

      allow create, update, delete:
        if isAdmin();
    }


    // ========================================
    // ORDERS
    // ========================================

    match /orders/{orderId} {

      allow create:
        if signedIn()
        && request.resource.data.userId
          == request.auth.uid;

      allow read:
        if (
          signedIn()
          && resource.data.userId
            == request.auth.uid
        )
        || isAdmin();

      allow update:
        if isAdmin()
        || (
          signedIn()

          && resource.data.userId
            == request.auth.uid

          && resource.data.status
            in ['paid', 'preparing']

          && request.resource.data.status
            == 'cancelled'

          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'status',
              'updatedAt'
            ])
        );

      allow delete:
        if false;
    }


    // ========================================
    // EVENT PARTICIPATIONS
    // ========================================

    match /eventParticipations/{participationId} {

      // 일반 사용자:
      // 자신의 참여 내역만 조회

      // 관리자:
      // 전체 회원 참여 내역 조회 가능
      allow read:
        if (
          signedIn()
          && resource.data.userId
            == request.auth.uid
        )
        || isAdmin();

      // 이벤트 결과 저장 / 포인트 지급 /
      // 당첨 정보 변경 등은
      // 클라이언트에서 직접 처리하지 않음
      allow create:
        if isAdmin()
        || (signedIn()
        && request.resource.data.userId == request.auth.uid
        && participationId
          == request.resource.data.eventId + '_' + request.auth.uid
        && request.resource.data.rewardPoints is int
        && request.resource.data.rewardPoints >= 0
        && (
          (
            request.resource.data.eventId == 'event-1'
            && request.resource.data.rewardPoints in [0, 100, 1000, 5000]
          )
          || (
            request.resource.data.eventId == 'event-2'
            && request.resource.data.rewardPoints <= 2500
            && request.resource.data.rewardPoints % 100 == 0
          )
          || (
            request.resource.data.eventId == 'event-3'
            && request.resource.data.rewardPoints <= 5000
            && request.resource.data.rewardPoints % 500 == 0
          )
        ));

      allow update, delete:
        if false;
    }

    // ========================================
    // INQUIRIES
    // ========================================

    function isValidInquiryCreate() {
      return request.resource.data.keys().hasAll([
        'category',
        'title',
        'content',
        'status',
        'createdAt'
      ])

        && request.resource.data.category is string
        && request.resource.data.category.size() > 0
        && request.resource.data.category.size() <= 30

        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100

        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 2000

        // 사용자가 임의로 답변 완료 상태로 등록하지 못하게 함
        && request.resource.data.status == 'pending'

        && request.resource.data.createdAt is timestamp;
    }


    match /inquiries/{inquiryId} {

      // ========================================
      // 문의 등록
      // 회원 / 비회원 모두 가능
      // ========================================

      allow create:
        if isValidInquiryCreate()

        && (
          // 로그인 회원
          (
            signedIn()

            && request.resource.data.userId
              == request.auth.uid
          )

          ||

          // 비회원
          (
            !signedIn()

            && (
              !request.resource.data.keys().hasAny([
                'userId'
              ])

              || request.resource.data.userId == null
            )
          )
        );


      // ========================================
      // 문의 조회
      // 회원: 자신의 문의만
      // 관리자: 전체 문의
      // ========================================

      allow read:
        if (
          signedIn()

          && resource.data.userId
            == request.auth.uid
        )

        || isAdmin();


      // ========================================
      // 문의 답변 / 상태 수정
      // 관리자만 가능
      // ========================================

      allow update:
        if isAdmin();


      // ========================================
      // 문의 삭제
      // 관리자만 가능
      // ========================================

      allow delete:
        if isAdmin();
    }


    // ========================================
    // DEFAULT DENY
    // ========================================

    match /{document=**} {
      allow read, write:
        if false;
    }
  }
}
